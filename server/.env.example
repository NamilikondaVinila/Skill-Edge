# Copy this file to `.env` (same folder) and adjust values.

# Port the backend listens on
PORT=5000

# Secret key to view/download enquiries:
#   http://localhost:5000/api/enquiries?key=YOUR_KEY        (JSON)
#   http://localhost:5000/api/enquiries.csv?key=YOUR_KEY    (Excel-friendly CSV)
# CHANGE THIS to a long random value before going live.
ADMIN_KEY=change-me-before-deploy

# Website address(es) allowed to call the API, comma-separated.
# Only needed if the frontend is hosted on a different domain than the backend.
ALLOWED_ORIGINS=http://localhost:5173

# OPTIONAL: forward every enquiry to a webhook (Google Apps Script, Zapier, Make, a CRM, etc.)
# Leave empty to disable.
ENQUIRY_WEBHOOK_URL=
